# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.deploy/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local booth photos, recipient addresses, and Gmail credentials
/.data/

# Generated from the pinned local inference packages at install/dev/build
/public/vendor/mediapipe/
/public/vendor/onnxruntime/

# Optional general-foreground weights are downloaded and verified by setup:foreground
/public/models/birefnet-*/model.onnx
/public/models/birefnet-*/model.onnx.download-*
/public/models/background-matting-mobilenet/model.onnx
/public/models/background-matting-mobilenet/model.onnx.download-*

# Optional local native AI environment and Python bytecode
/.venv-ai/
__pycache__/
