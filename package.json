{
  "name": "photokiosk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "deploy": "node scripts/deploy.mjs",
    "deploy:install": "node scripts/deploy.mjs install",
    "deploy:status": "node scripts/deploy.mjs status",
    "deploy:stop": "node scripts/deploy.mjs stop",
    "kiosk:install": "node scripts/kiosk.mjs install",
    "kiosk:start": "node scripts/kiosk.mjs start",
    "kiosk:stop": "node scripts/kiosk.mjs stop",
    "kiosk:status": "node scripts/kiosk.mjs status",
    "kiosk:uninstall": "node scripts/kiosk.mjs uninstall",
    "touch:install": "node scripts/touchscreen.mjs install",
    "touch:status": "node scripts/touchscreen.mjs status",
    "touch:calibrate": "node scripts/touchscreen.mjs calibrate",
    "touch:stop": "node scripts/touchscreen.mjs stop",
    "touch:start": "node scripts/touchscreen.mjs start",
    "touch:uninstall": "node scripts/touchscreen.mjs uninstall",
    "lint": "eslint",
    "test": "node --import tsx --test src/lib/*.test.* src/components/kiosk/*.test.*",
    "test:deploy": "node --test tests/deployment-hooks.test.mjs tests/kiosk.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
